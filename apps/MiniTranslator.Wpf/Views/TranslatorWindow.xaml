<Window x:Class="MiniTranslator.Wpf.Views.TranslatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MiniTranslator.Presentation.ViewModels;assembly=MiniTranslator.Presentation"
        xmlns:controls="clr-namespace:MiniTranslator.Wpf.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:TranslatorViewModel}"
        Title="MiniTranslator" Icon="/MiniTranslator;component/Assets/app.ico" UseLayoutRounding="True"
        Language="{DynamicResource UiCulture}" FontFamily="{DynamicResource AppFontFamily}"
        FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Width="580" Height="560" MinWidth="440" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource AppSurfaceBrush}"
        WindowStartupLocation="Manual"
        ShowActivated="False" Topmost="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="12"
                      GlassFrameThickness="-1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Template>
        <ControlTemplate TargetType="Window">
            <Border Background="{TemplateBinding Background}">
                <AdornerDecorator>
                    <ContentPresenter />
                </AdornerDecorator>
            </Border>
        </ControlTemplate>
    </Window.Template>

    <Grid x:Name="RootChrome">
        <Grid x:Name="TranslationView">
            <Grid.InputBindings>
                <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding TranslateCommand}" />
                <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SwapLanguagesCommand}" />
                <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CopyCommand}" />
                <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
            </Grid.InputBindings>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="TopBar" Grid.Row="0" Padding="16,0,12,0"
                    SizeChanged="OnTopBarSizeChanged"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Source="/MiniTranslator;component/Assets/app.ico" Width="18" Height="18"
                           Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />

                    <Border Grid.Column="1" Margin="0,0,8,0" HorizontalAlignment="Left"
                            Style="{StaticResource SpotlightPillContainerStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="SourceLanguageBox" Grid.Column="0"
                                      Style="{StaticResource SpotlightLanguageComboBoxStyle}"
                                      MaxWidth="140" KeyboardNavigation.TabIndex="0"
                                      AutomationProperties.Name="{DynamicResource SourceLanguage}"
                                      ItemsSource="{Binding SourceLanguages}" SelectedItem="{Binding SelectedSource}"
                                      ItemTemplate="{StaticResource LanguageItemTemplate}" />
                            <Button x:Name="SwapButton" Grid.Column="1" Margin="1,0"
                                    Style="{StaticResource SpotlightRoundIconButtonStyle}"
                                    KeyboardNavigation.TabIndex="1"
                                    Command="{Binding SwapLanguagesCommand}"
                                    ToolTip="{DynamicResource SwapLanguagesShortcut}"
                                    AutomationProperties.Name="{DynamicResource SwapLanguages}"
                                    AutomationProperties.AcceleratorKey="Ctrl+Shift+S">
                                <TextBlock Style="{StaticResource IconStyle}" FontSize="12" Text="&#xE8AB;" />
                            </Button>
                            <ComboBox x:Name="TargetLanguageBox" Grid.Column="2"
                                      Style="{StaticResource SpotlightLanguageComboBoxStyle}"
                                      MaxWidth="140" KeyboardNavigation.TabIndex="2"
                                      AutomationProperties.Name="{DynamicResource TargetLanguage}"
                                      ItemsSource="{Binding TargetLanguages}" SelectedItem="{Binding SelectedTarget}"
                                      ItemTemplate="{StaticResource LanguageItemTemplate}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <ToggleButton x:Name="EngineQuickButton" Margin="0,0,4,0"
                                      Style="{StaticResource SpotlightEnginePillStyle}"
                                      KeyboardNavigation.TabIndex="8"
                                      ToolTip="{Binding ActiveEngineSummary}"
                                      AutomationProperties.Name="{DynamicResource QuickEngineSwitch}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource IconStyle}" FontSize="11" Margin="0,0,5,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="&#xE945;" />
                                <TextBlock Text="{Binding ActiveEngineName}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource IconStyle}" FontSize="9" Margin="5,0,0,0" Text="&#xE70D;" />
                            </StackPanel>
                        </ToggleButton>

                        <Popup x:Name="EngineQuickPopup"
                               PlacementTarget="{Binding ElementName=EngineQuickButton}"
                               Placement="Custom"
                               IsOpen="{Binding IsChecked, ElementName=EngineQuickButton, Mode=TwoWay}"
                               StaysOpen="False" AllowsTransparency="True">
                            <Grid Margin="16,6,16,20">
                                <Border x:Name="EnginePopupSurface" MinWidth="232" CornerRadius="10"
                                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                        BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.22" Color="#000000" />
                                    </Border.Effect>
                                    <Border CornerRadius="9" Padding="6"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                        <StackPanel>
                                            <TextBlock Margin="10,4,10,6" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{DynamicResource QuickEngineSwitchTitle}" />

                                            <Button Style="{StaticResource SpotlightPresetItemStyle}"
                                                    Command="{Binding SelectEnginePresetCommand}" CommandParameter="Claude:sonnet"
                                                    Click="OnEnginePresetClick">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="12.5" FontWeight="Medium" Text="Claude · sonnet" />
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Text="{DynamicResource PresetClaudeFast}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Style="{StaticResource IconStyle}" FontSize="12"
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="&#xE73E;"
                                                               Visibility="{Binding IsClaudeSonnetActive, Converter={StaticResource BooleanToVisibility}}" />
                                                </Grid>
                                            </Button>

                                            <Button Style="{StaticResource SpotlightPresetItemStyle}"
                                                    Command="{Binding SelectEnginePresetCommand}" CommandParameter="Claude:opus"
                                                    Click="OnEnginePresetClick">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="12.5" FontWeight="Medium" Text="Claude · opus" />
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Text="{DynamicResource PresetClaudeQuality}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Style="{StaticResource IconStyle}" FontSize="12"
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="&#xE73E;"
                                                               Visibility="{Binding IsClaudeOpusActive, Converter={StaticResource BooleanToVisibility}}" />
                                                </Grid>
                                            </Button>

                                            <Button Style="{StaticResource SpotlightPresetItemStyle}"
                                                    Command="{Binding SelectEnginePresetCommand}" CommandParameter="Claude:haiku"
                                                    Click="OnEnginePresetClick">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="12.5" FontWeight="Medium" Text="Claude · haiku" />
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Text="{DynamicResource PresetClaudeLight}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Style="{StaticResource IconStyle}" FontSize="12"
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="&#xE73E;"
                                                               Visibility="{Binding IsClaudeHaikuActive, Converter={StaticResource BooleanToVisibility}}" />
                                                </Grid>
                                            </Button>

                                            <Border Height="1" Margin="8,4" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                                            <Button Style="{StaticResource SpotlightPresetItemStyle}"
                                                    Command="{Binding SelectEnginePresetCommand}" CommandParameter="Codex:gpt-6.1-terra"
                                                    Click="OnEnginePresetClick">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="12.5" FontWeight="Medium" Text="Codex · gpt-6.1-terra" />
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Text="{DynamicResource PresetCodexDefault}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Style="{StaticResource IconStyle}" FontSize="12"
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="&#xE73E;"
                                                               Visibility="{Binding IsCodexActive, Converter={StaticResource BooleanToVisibility}}" />
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Grid>
                        </Popup>

                        <ToggleButton x:Name="PinButton" Margin="0,0,2,0"
                                      Style="{StaticResource SpotlightPinButtonStyle}"
                                      KeyboardNavigation.TabIndex="9"
                                      IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                      ToolTip="{DynamicResource PinWindow}"
                                      AutomationProperties.Name="{DynamicResource PinWindow}">
                            <TextBlock FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource IconStyle}">
                                        <Setter Property="Text" Value="&#xE718;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                <Setter Property="Text" Value="&#xE840;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ToggleButton>

                        <Button x:Name="SettingsButton" Margin="0,0,2,0"
                                Style="{StaticResource SpotlightIconButtonStyle}"
                                KeyboardNavigation.TabIndex="10"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip="{DynamicResource SettingsShortcut}"
                                AutomationProperties.Name="{DynamicResource Settings}"
                                AutomationProperties.AcceleratorKey="Ctrl+,">
                            <TextBlock Style="{StaticResource IconStyle}" FontSize="14" Text="&#xE713;" />
                        </Button>

                        <Button x:Name="CloseButton"
                                Style="{StaticResource SpotlightCloseButtonStyle}"
                                KeyboardNavigation.TabIndex="11"
                                Click="OnCloseButtonClick"
                                ToolTip="{DynamicResource CloseWindow}"
                                AutomationProperties.Name="{DynamicResource CloseWindow}">
                            <TextBlock Style="{StaticResource IconStyle}" FontSize="11" Text="&#xE8BB;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="TranslationPanels" Grid.Row="1" SizeChanged="OnTranslationPanelsSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="PanelColumnGap" Width="0" />
                    <ColumnDefinition x:Name="ResultColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="PanelRowGap" Height="1" />
                    <RowDefinition x:Name="ResultRow" Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="SourcePanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBox x:Name="SourceTextBox"
                                 Style="{StaticResource SpotlightTextBoxStyle}"
                                 KeyboardNavigation.TabIndex="3"
                                 AutomationProperties.Name="{DynamicResource SourceText}"
                                 AutomationProperties.HelpText="{DynamicResource SourceTextHelp}"
                                 Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                 FontSize="15" Padding="14,14,14,6" MinHeight="48" MaxLength="5000" />
                        <TextBlock x:Name="SourcePlaceholder" Margin="16,14,16,6" FontSize="15"
                                   IsHitTestVisible="False" Text="{DynamicResource SourcePlaceholder}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SourceText.Length}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="1" Margin="16,4,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"
                                       Text="{Binding CharacterCount}" />
                            <Button x:Name="ClearButton" Margin="8,0,0,0"
                                    Style="{StaticResource SpotlightGhostButtonStyle}"
                                    KeyboardNavigation.TabIndex="4"
                                    Command="{Binding ClearCommand}" Click="OnClearClick"
                                    ToolTip="{DynamicResource ClearAllHint}"
                                    AutomationProperties.Name="{DynamicResource ClearAll}"
                                    Content="{DynamicResource Clear}" />
                        </StackPanel>

                        <Button x:Name="TranslateButton" Grid.Column="1" MinWidth="96"
                                Style="{StaticResource SpotlightPillAccentButtonStyle}"
                                KeyboardNavigation.TabIndex="5"
                                Command="{Binding TranslateCommand}"
                                ToolTip="{DynamicResource TranslateShortcut}"
                                AutomationProperties.Name="{DynamicResource Translate}"
                                AutomationProperties.AcceleratorKey="Ctrl+Enter">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource Translate}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTranslating}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource TranslateAgain}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource IconStyle}" FontSize="10" Margin="6,0,0,0"
                                           VerticalAlignment="Center" Opacity="0.85" Text="&#xE751;" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <Border x:Name="PanelDivider" Grid.Row="1" Grid.Column="0"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <Border x:Name="ResultPanel" Grid.Row="2" Grid.Column="0"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ProgressBar Grid.Row="0" Height="2" VerticalAlignment="Top"
                                     Background="Transparent" BorderThickness="0"
                                     IsIndeterminate="True" Panel.ZIndex="2"
                                     AutomationProperties.Name="{DynamicResource TranslatingAccessible}"
                                     Visibility="{Binding IsTranslating, Converter={StaticResource BooleanToVisibility}}" />

                        <Grid Grid.Row="0">
                            <TextBox x:Name="ResultTextBox"
                                     Style="{StaticResource SpotlightTextBoxStyle}"
                                     KeyboardNavigation.TabIndex="6"
                                     AutomationProperties.Name="{DynamicResource TranslationResult}"
                                     AutomationProperties.HelpText="{DynamicResource ResultTextHelp}"
                                     Text="{Binding TranslatedText, Mode=OneWay}" IsReadOnly="True"
                                     TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                     FontSize="15" Padding="14,14,14,6" MinHeight="48" />
                            <TextBlock x:Name="ResultPlaceholder" Margin="16,14,16,6" FontSize="15"
                                       IsHitTestVisible="False" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{DynamicResource ResultPlaceholder}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TranslatedText.Length}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsTranslating}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource TranslatingPlaceholder}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}" Value="Visible">
                                                <Setter Property="Text" Value="{DynamicResource RetryAfterError}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Grid.Row="1" Margin="16,4,16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <controls:LiveTextBlock VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite">
                                <controls:LiveTextBlock.Style>
                                    <Style TargetType="controls:LiveTextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                        <Setter Property="Text" Value="{Binding InfoMessage}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTranslating}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource Translating}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:LiveTextBlock.Style>
                            </controls:LiveTextBlock>

                            <Button x:Name="CopyButton" Grid.Column="1" Margin="8,0,0,0"
                                    Style="{StaticResource SpotlightPillButtonStyle}"
                                    KeyboardNavigation.TabIndex="7"
                                    Command="{Binding CopyCommand}"
                                    ToolTip="{DynamicResource CopyShortcut}"
                                    AutomationProperties.Name="{DynamicResource CopyResult}"
                                    AutomationProperties.AcceleratorKey="Ctrl+Shift+C">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontSize="12" Margin="0,0,6,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource IconStyle}">
                                                <Setter Property="Text" Value="&#xE8C8;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                        <Setter Property="Text" Value="&#xE73E;" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{DynamicResource Copy}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                        <Setter Property="Text" Value="{DynamicResource CopiedShort}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="TranslationErrorBar" Grid.Row="2" Margin="16,8,16,8"
                    Style="{StaticResource ErrorInfoBarStyle}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource IconStyle}" VerticalAlignment="Top" Margin="0,2,10,0"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="&#xEB90;" />
                    <controls:LiveTextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding ErrorMessage}"
                                            AutomationProperties.LiveSetting="Assertive" />
                </Grid>
            </Border>

            <Border Grid.Row="3" Padding="16,7"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource KeycapStyle}">
                            <TextBlock Style="{StaticResource KeycapTextStyle}" Text="Ctrl+Enter" />
                        </Border>
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="5,0,12,0"
                                   VerticalAlignment="Center" Text="{DynamicResource Translate}" />

                        <Border Style="{StaticResource KeycapStyle}">
                            <TextBlock Style="{StaticResource KeycapTextStyle}" Text="Ctrl+Shift+C" />
                        </Border>
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="5,0,0,0"
                                   VerticalAlignment="Center" Text="{DynamicResource Copy}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource KeycapStyle}">
                            <TextBlock Style="{StaticResource KeycapTextStyle}" Text="{Binding CompactHotkeyText, Mode=OneWay}" />
                        </Border>
                        <Border Style="{StaticResource KeycapStyle}" Margin="8,0,0,0">
                            <TextBlock Style="{StaticResource KeycapTextStyle}" Text="Esc" />
                        </Border>
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="5,0,0,0"
                                   VerticalAlignment="Center" Text="{DynamicResource ShortcutHide}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <ContentControl x:Name="SettingsHost" Visibility="Collapsed" />
    </Grid>
</Window>
