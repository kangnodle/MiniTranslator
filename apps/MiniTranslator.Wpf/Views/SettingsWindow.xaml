<Window x:Class="MiniTranslator.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MiniTranslator.Presentation.ViewModels;assembly=MiniTranslator.Presentation"
        xmlns:controls="clr-namespace:MiniTranslator.Wpf.Controls"
        xmlns:settings="clr-namespace:MiniTranslator.Domain.Settings;assembly=MiniTranslator.Domain"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="{DynamicResource SettingsTitle}"
        Language="{DynamicResource UiCulture}"
        UseLayoutRounding="True"
        FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Icon="/MiniTranslator;component/Assets/app.ico"
        Width="720" Height="620"
        MinWidth="560" MinHeight="480"
        Background="{DynamicResource AppSurfaceBrush}"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=Scroller}">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Alt" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,16,24,0">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{DynamicResource Settings}" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"
                       Text="{DynamicResource SettingsHint}" />
        </StackPanel>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,16">
            <StackPanel>

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{DynamicResource Appearance}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource IconStyle}" VerticalAlignment="Top" Margin="0,4,16,0" Text="&#xE790;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="{DynamicResource Theme}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                       Text="{DynamicResource ThemeHint}" />
                            <ComboBox x:Name="ThemeBox" Margin="0,12,0,0" MinHeight="32"
                                      AutomationProperties.Name="{DynamicResource Theme}"
                                      SelectedValuePath="Tag" SelectedValue="{Binding Theme, Mode=OneWay}"
                                      SelectionChanged="OnThemeSelectionChanged"
                                      IsEnabled="{Binding SetThemeCommand.IsRunning, Converter={StaticResource InverseBoolean}}">
                                <ComboBoxItem Content="{DynamicResource System}" Tag="{x:Static settings:AppTheme.System}" />
                                <ComboBoxItem Content="{DynamicResource Light}" Tag="{x:Static settings:AppTheme.Light}" />
                                <ComboBoxItem Content="{DynamicResource Dark}" Tag="{x:Static settings:AppTheme.Dark}" />
                                <ComboBoxItem Content="Tomorrow Night Blue" Tag="{x:Static settings:AppTheme.TomorrowNightBlue}" />
                                <ComboBoxItem Content="Solarized Light" Tag="{x:Static settings:AppTheme.SolarizedLight}" />
                                <ComboBoxItem Content="Solarized Dark" Tag="{x:Static settings:AppTheme.SolarizedDark}" />
                            </ComboBox>
                            <controls:LiveTextBlock Text="{Binding ThemeError}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                    AutomationProperties.LiveSetting="Assertive"
                                                    Visibility="{Binding ThemeError, Converter={StaticResource HasValueToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{DynamicResource Hotkeys}" />

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource IconStyle}" VerticalAlignment="Top" Margin="0,4,16,0" Text="&#xE765;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="{DynamicResource OpenTranslator}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                       Text="{DynamicResource HotkeyHint}" />
                            <controls:LiveTextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Assertive"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Text="{Binding HotkeyError}"
                                       Visibility="{Binding HotkeyError, Converter={StaticResource HasValueToVisibility}}" />
                        </StackPanel>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:HotkeyBox x:Name="HotkeyBox"
                                                HorizontalContentAlignment="Center"
                                                AutomationProperties.Name="{DynamicResource HotkeyInput}"
                                                AutomationProperties.HelpText="{DynamicResource HotkeyHelp}"
                                                Gesture="{Binding Hotkey}"
                                                RecordCommand="{Binding RecordHotkeyCommand}"
                                                GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                                LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding ResetHotkeyCommand}"
                                    AutomationProperties.Name="{DynamicResource ResetDefault}">
                                <Button.ToolTip>
                                    <TextBlock>
                                        <Run Text="{DynamicResource ResetDefaultPrefix}" /><Run Text="{Binding DefaultHotkeyText, Mode=OneWay}" /><Run Text="{DynamicResource ResetDefaultSuffix}" />
                                    </TextBlock>
                                </Button.ToolTip>
                                <TextBlock Style="{StaticResource IconStyle}" Text="&#xE777;" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{DynamicResource Languages}" />

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <Label Style="{StaticResource FieldLabelStyle}" Content="{DynamicResource UiLanguage}"
                               Target="{Binding ElementName=UiLanguageBox}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{DynamicResource UiLanguageHint}" />
                        <ComboBox x:Name="UiLanguageBox" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="{DynamicResource UiLanguage}"
                                  SelectedValuePath="Tag" SelectedValue="{Binding UiLanguage}">
                            <ComboBoxItem Content="한국어" Language="ko-KR" Tag="{x:Static settings:UiLanguage.Korean}" />
                            <ComboBoxItem Content="English" Language="en-US" Tag="{x:Static settings:UiLanguage.English}" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <Label Style="{StaticResource FieldLabelStyle}" Content="{DynamicResource TranslationEngine}"
                               Target="{Binding ElementName=EngineBox}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{DynamicResource TranslationEngineHint}" />
                        <ComboBox x:Name="EngineBox" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="{DynamicResource TranslationEngine}"
                                  SelectedValuePath="Tag" SelectedValue="{Binding Engine}">
                            <ComboBoxItem Content="{DynamicResource EngineGoogle}" Tag="{x:Static settings:TranslationEngine.Google}" />
                            <ComboBoxItem Content="{DynamicResource EngineClaude}" Tag="{x:Static settings:TranslationEngine.Claude}" />
                            <ComboBoxItem Content="{DynamicResource EngineCodex}" Tag="{x:Static settings:TranslationEngine.Codex}" />
                        </ComboBox>
                        <StackPanel Margin="0,16,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Engine}" Value="{x:Static settings:TranslationEngine.Codex}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Label Style="{StaticResource FieldLabelStyle}" Content="{DynamicResource CodexExecutablePath}"
                                   Target="{Binding ElementName=CodexExecutablePathBox}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{DynamicResource CodexExecutablePathHint}" />
                            <TextBox x:Name="CodexExecutablePathBox" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                     AutomationProperties.Name="{DynamicResource CodexExecutablePath}"
                                     Text="{Binding CodexExecutablePath, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Style="{StaticResource CardTitleStyle}" Margin="0,16,0,0" Text="{DynamicResource CodexAccount}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{DynamicResource CodexAccountHint}" />
                            <controls:LiveTextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   Text="{Binding CodexAccountText}"
                                                   Visibility="{Binding CodexAccountText, Converter={StaticResource HasValueToVisibility}}" />
                            <controls:LiveTextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Assertive"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                   Text="{Binding CodexAccountError}"
                                                   Visibility="{Binding CodexAccountError, Converter={StaticResource HasValueToVisibility}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button MinWidth="120" MinHeight="32" Padding="16,6"
                                        Command="{Binding SignInToCodexCommand}" Content="{DynamicResource CodexSignIn}"
                                        Visibility="{Binding CanOfferCodexSignIn, Converter={StaticResource BooleanToVisibility}}" />
                                <Button MinWidth="120" MinHeight="32" Padding="16,6"
                                        Command="{Binding SignInToCodexCancelCommand}" Content="{DynamicResource CodexSignInCancel}"
                                        Visibility="{Binding IsCodexSigningIn, Converter={StaticResource BooleanToVisibility}}" />
                                <Button MinWidth="120" MinHeight="32" Padding="16,6"
                                        Command="{Binding SignOutOfCodexCommand}" Content="{DynamicResource CodexSignOut}"
                                        Visibility="{Binding IsCodexSignedIn, Converter={StaticResource BooleanToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource IconStyle}" Margin="0,0,16,0" Text="&#xF2B7;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="{DynamicResource TranslationLanguages}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                       Text="{DynamicResource TranslationLanguagesHint}" />
                        </StackPanel>

                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Column="0" Style="{StaticResource FieldLabelStyle}"
                                   Content="{DynamicResource SourceLanguageLabel}" Target="{Binding ElementName=SettingsSourceLanguageBox}" />
                            <Label Grid.Column="2" Style="{StaticResource FieldLabelStyle}"
                                   Content="{DynamicResource TargetLanguageLabel}" Target="{Binding ElementName=SettingsTargetLanguageBox}" />
                            <ComboBox x:Name="SettingsSourceLanguageBox" Grid.Row="1" Grid.Column="0"
                                      AutomationProperties.Name="{DynamicResource SourceLanguage}"
                                      ItemsSource="{Binding SourceLanguages}"
                                      SelectedItem="{Binding SourceLanguage}"
                                      ItemTemplate="{StaticResource LanguageItemTemplate}"
                                      HorizontalAlignment="Stretch" />
                            <Button Grid.Row="1" Grid.Column="1" Margin="8,0" Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding SwapLanguagesCommand}"
                                    ToolTip="{DynamicResource SwapLanguages}" AutomationProperties.Name="{DynamicResource SwapLanguages}">
                                <TextBlock Style="{StaticResource IconStyle}" Text="&#xE8AB;" />
                            </Button>
                            <ComboBox x:Name="SettingsTargetLanguageBox" Grid.Row="1" Grid.Column="2"
                                      AutomationProperties.Name="{DynamicResource TargetLanguage}"
                                      ItemsSource="{Binding TargetLanguages}"
                                      SelectedItem="{Binding TargetLanguage}"
                                      ItemTemplate="{StaticResource LanguageItemTemplate}"
                                      HorizontalAlignment="Stretch" />
                            <controls:LiveTextBlock Grid.Row="2" Grid.ColumnSpan="3" Margin="0,6,0,0" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Assertive"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Text="{Binding LanguageError}"
                                       Visibility="{Binding LanguageError, Converter={StaticResource HasValueToVisibility}}" />
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{DynamicResource Behavior}" />

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource IconStyle}" Margin="0,0,16,0" Text="&#xE7E8;" />
                        <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="{DynamicResource StartWithWindows}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                       Text="{DynamicResource StartWithWindowsHint}" />
                            <controls:LiveTextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Assertive"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                   Text="{Binding StartupError}"
                                                   Visibility="{Binding StartupError, Converter={StaticResource HasValueToVisibility}}" />
                        </StackPanel>
                        <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Column="2" VerticalAlignment="Center" Content="{DynamicResource Use}"
                                  AutomationProperties.Name="{DynamicResource StartWithWindows}"
                                  IsEnabled="{Binding CanConfigureStartup}"
                                  IsChecked="{Binding StartWithWindows}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource IconStyle}" Margin="0,0,16,0" Text="&#xE8C8;" />
                        <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="{DynamicResource CaptureSelection}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                       Text="{DynamicResource CaptureSelectionHint}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" VerticalAlignment="Center" Content="{DynamicResource Use}"
                                  AutomationProperties.Name="{DynamicResource CaptureSelection}"
                                  IsChecked="{Binding CaptureSelectionOnHotkey}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource IconStyle}" Margin="0,0,16,0" Text="&#xE895;" />
                        <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="{DynamicResource AutoTranslateOnCapture}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                       Text="{DynamicResource AutoTranslateOnCaptureHint}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" VerticalAlignment="Center" Content="{DynamicResource Use}"
                                  AutomationProperties.Name="{DynamicResource AutoTranslateOnCapture}"
                                  IsEnabled="{Binding CaptureSelectionOnHotkey}"
                                  IsChecked="{Binding AutoTranslateOnCapture}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource IconStyle}" Margin="0,0,16,0" Text="&#xE73F;" />
                        <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="{DynamicResource HideOnDeactivate}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                       Text="{DynamicResource HideOnDeactivateHint}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" VerticalAlignment="Center" Content="{DynamicResource Use}"
                                  AutomationProperties.Name="{DynamicResource HideOnDeactivate}"
                                  IsChecked="{Binding HideOnDeactivate}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="SaveErrorBar" Grid.ColumnSpan="3" Margin="0,0,0,12"
                        Style="{StaticResource ErrorInfoBarStyle}"
                        Visibility="{Binding SaveError, Converter={StaticResource HasValueToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource IconStyle}" VerticalAlignment="Top" Margin="0,2,12,0"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="&#xEB90;" />
                        <controls:LiveTextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding SaveError}"
                                                AutomationProperties.LiveSetting="Assertive" />
                    </Grid>
                </Border>
                <Button Grid.Row="1" Grid.Column="1" MinWidth="120" MinHeight="32" Padding="16,6" Margin="0,0,8,0"
                        Style="{DynamicResource AccentButtonStyle}"
                        Command="{Binding SaveCommand}" Content="{DynamicResource Save}" IsDefault="True"
                        AutomationProperties.AccessKey="Alt+S" />
                <Button Grid.Row="1" Grid.Column="2" MinWidth="120" MinHeight="32" Padding="16,6"
                        Command="{Binding CancelCommand}" IsCancel="True" Content="{DynamicResource Cancel}" />
            </Grid>
        </Border>
    </Grid>
</Window>
