<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Adapter: implements ITranslator over HTTP (Google Translate public endpoint).
    GoogleTranslateProtocol is the pure request/response mapping; GoogleTranslator is the thin I/O shell.
  -->
  <PropertyGroup>
    <TargetFramework>$(PortableTargetFramework)</TargetFramework>
    <RootNamespace>MiniTranslator.Adapters.GoogleTranslate</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\MiniTranslator.Application\MiniTranslator.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MiniTranslator.Adapters.GoogleTranslate.Tests" />
  </ItemGroup>

</Project>
