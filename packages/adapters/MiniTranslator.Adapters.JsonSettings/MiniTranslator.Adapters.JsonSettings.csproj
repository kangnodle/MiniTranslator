<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Adapter: implements ISettingsRepository as a JSON file.
    SettingsMapper is the pure document/domain mapping; JsonSettingsRepository is the thin file-system shell.
  -->
  <PropertyGroup>
    <TargetFramework>$(PortableTargetFramework)</TargetFramework>
    <RootNamespace>MiniTranslator.Adapters.JsonSettings</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\MiniTranslator.Application\MiniTranslator.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MiniTranslator.Adapters.JsonSettings.Tests" />
  </ItemGroup>

</Project>
