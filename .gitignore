# These are source projects, not restored NuGet packages (ignored by the parent repository).
!/packages/
!/packages/**

# .NET build and release output
[Bb]in/
[Oo]bj/
/artifacts/

# Test results, coverage and MSBuild diagnostics
[Tt]est[Rr]esults/
*.trx
*.coverage
*.coveragexml
*.binlog

# Visual Studio user state
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Local Claude overrides; shared configuration remains tracked
/.claude/settings.local.json

# Regenerable graft graph cache (run `graft build`)
/graft/
