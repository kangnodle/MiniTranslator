<Project>
  <!-- Settings shared by every project in the workspace. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.2.0</Version>
    <Company>MiniTranslator</Company>
    <Product>MiniTranslator</Product>
    <SatelliteResourceLanguages>en;ko</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Workspace-wide target frameworks: portable code stays on net10.0; only OS adapters and the app use -windows. -->
  <PropertyGroup>
    <PortableTargetFramework>net10.0</PortableTargetFramework>
    <WindowsTargetFramework>net10.0-windows</WindowsTargetFramework>
  </PropertyGroup>
</Project>
