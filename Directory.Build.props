<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.2.0</Version>
    <Company>MiniTranslator</Company>
    <Product>MiniTranslator</Product>
    <SatelliteResourceLanguages>en;ko</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <PortableTargetFramework>net11.0</PortableTargetFramework>
    <WindowsTargetFramework>net11.0-windows</WindowsTargetFramework>
  </PropertyGroup>
</Project>
